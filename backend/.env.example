# ==============================================================================
#                      AXLY URL SHORTENER — ENVIRONMENT CONFIG
# ==============================================================================
# This template demonstrates both LOCAL DEVELOPMENT and PRODUCTION configurations.
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME MODE
# ------------------------------------------------------------------------------
PORT=5000

# [LOCAL DEV MODE] - Lenient secrets, dev logging, Morgan enabled
NODE_ENV=development

# [PRODUCTION MODE] - Strict 32+ char secret validation, optimized logging
# NODE_ENV=production


# ==============================================================================
# 2. DATABASE CONFIGURATION (Choose Preset A or Preset B)
# ==============================================================================

# ------------------------------------------------------------------------------
# [PRESET A] SUPABASE CLOUD POSTGRESQL (Recommended for Production & Staging)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection string -> URI
#
# Option 1: Transaction Pooler (Port 6543 - Best for serverless / multi-instance):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option 2: Session Pooler / Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Enable SSL when using Supabase:
# DB_SSL=true

# ------------------------------------------------------------------------------
# [PRESET B] LOCAL / DOCKER POSTGRESQL (Active by default for local development)
# ------------------------------------------------------------------------------
# Used automatically whenever DATABASE_URL is not set or commented out:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=axly_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# Connection Pool Limits (Applied to both Local and Supabase)
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000


# ==============================================================================
# 3. DOMAIN NAMES & URL ROUTING (Choose Preset A or Preset B)
# ==============================================================================

# ------------------------------------------------------------------------------
# [PRESET A] LOCALHOST (Active by default)
# ------------------------------------------------------------------------------
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
SHORT_DOMAIN=http://localhost:5000
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# [PRESET B] PRODUCTION CUSTOM DOMAINS (url.axly.in & s.axly.in)
# ------------------------------------------------------------------------------
# Uncomment these 4 lines when deploying to production behind Nginx/Cloudflare:
# APP_URL=https://url.axly.in
# FRONTEND_URL=https://url.axly.in
# SHORT_DOMAIN=https://s.axly.in
# TRUST_PROXY=1


# ==============================================================================
# 4. AUTHENTICATION & CRYPTOGRAPHY (Shared Secure Keys)
# ==============================================================================
# Generate a new 256-bit key via:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key_here
JWT_EXPIRES_IN=7d

# Salt for privacy-preserving visitor deduplication (HMAC-SHA256)
VISITOR_SALT=replace_with_a_random_salt_for_visitor_hash_2026


# ==============================================================================
# 5. RATE LIMITING & SECURITY THRESHOLDS
# ==============================================================================
# Global API Limiter (15 minutes, 100 requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# URL Creation Limiter (1 hour, 50 link creations)
CREATE_RATE_LIMIT_WINDOW_MS=3600000
CREATE_RATE_LIMIT_MAX=50

# Authentication Limiter (15 minutes, 10 login/registration attempts)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
