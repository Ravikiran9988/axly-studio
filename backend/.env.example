# ==============================================================================
# Axly URL Shortener — Backend Configuration
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration (Choose Option A for Supabase OR Option B for Local)
# ------------------------------------------------------------------------------

# Option A: Supabase Cloud PostgreSQL (Recommended for Production)
# - Direct connection: postgresql://postgres.[REF]:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
# - Connection pooler (Transaction mode): postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Option B: Local / Containerized PostgreSQL (Used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=axly_db
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
DB_SSL=false

# Database Pool Settings
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Generate a secure 64-char hex key via:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production, startup will fail if this is left as default or shorter than 32 chars.
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key_here
JWT_EXPIRES_IN=7d

# Secret salt for privacy-preserving visitor deduplication hashing
VISITOR_SALT=replace_with_a_random_salt_for_visitor_hash_2026

# ------------------------------------------------------------------------------
# Application Domains & URLs
# ------------------------------------------------------------------------------
# Local Development:
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
SHORT_DOMAIN=http://localhost:5000

# Production Examples:
# APP_URL=https://url.axly.in
# FRONTEND_URL=https://url.axly.in
# SHORT_DOMAIN=https://s.axly.in

# ------------------------------------------------------------------------------
# Reverse Proxy & Rate Limiting
# ------------------------------------------------------------------------------
# Set to 'true' or '1' when deployed behind Nginx, Cloudflare, or AWS ALB
TRUST_PROXY=false

# Global API limiter (15 min window, max 100 requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# URL Creation limiter (1 hour window, max 50 creations)
CREATE_RATE_LIMIT_WINDOW_MS=3600000
CREATE_RATE_LIMIT_MAX=50

# Authentication limiter (15 min window, max 10 attempts)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
