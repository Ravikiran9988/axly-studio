# Axly URL Shortener - Environment Variables
# Copy this file to .env and fill in the values.
# Never commit your real .env file or production secrets.

# Server
PORT=5000
NODE_ENV=development

# Database option A: local PostgreSQL / Docker Compose (development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=axly_db
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# Database option B: hosted PostgreSQL such as Supabase (production)
# Use the connection string from Supabase Dashboard -> Connect.
# Prefer the Session Pooler connection string if your hosting provider
# cannot use Supabase's direct IPv6 endpoint.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:5432/postgres
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_SSL_REJECT_UNAUTHORIZED=true

# JWT: generate a long, random secret for each environment.
JWT_SECRET=replace_with_a_long_random_development_secret
JWT_EXPIRES_IN=7d

# App URLs
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
SHORT_DOMAIN=http://localhost:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
