# ==============================================================================
# AXLY STUDIO TELEGRAM BOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Telegram Bot Token from @BotFather
# Create a bot at https://t.me/BotFather and paste the token here:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Axly Backend API & Frontend URL
# For local development: http://localhost:5000
# For production: https://axly-api.onrender.com
AXLY_API_URL=http://localhost:5000
AXLY_FRONTEND_URL=https://url.axly.in

# 3. Internal Service-to-Service Shared Secret
# Must match TELEGRAM_BOT_SECRET on the Axly API server
TELEGRAM_BOT_SECRET=replace_with_a_secure_random_32_character_bot_secret

# 4. Bot Execution Mode & Web Server
NODE_ENV=development
PORT=3000

# Set to true if deploying as a Webhook on Render/Cloudflare, or leave false for long-polling
USE_WEBHOOK=false
# WEBHOOK_DOMAIN=https://axly-telegram-bot.onrender.com
