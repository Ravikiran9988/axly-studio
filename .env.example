# ==============================================================================
# Axly URL Shortener — Docker Compose Environment Configuration
# Copy this file to .env before running `docker compose up`
# ==============================================================================

# Database Settings (Local Postgres container)
DB_NAME=axly_db
DB_USER=postgres
DB_PASSWORD=axly_local_dev_password

# To connect the containerized backend to Supabase Cloud instead of local postgres:
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# DB_SSL=true

# Security
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key_here
JWT_EXPIRES_IN=7d

# Visitor analytics hashing secret. Leave empty for local development fallback.
# Production must set a unique random value of at least 32 characters.
VISITOR_SALT=

# Domains
FRONTEND_URL=http://localhost
SHORT_DOMAIN=http://localhost:5000
